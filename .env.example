# =============================================================================
# START-X — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env to version control.
#
# SECURITY RULES:
#   - Variables prefixed VITE_  are exposed to the browser. Keep them safe.
#   - Variables WITHOUT VITE_  are server/Edge Function only. NEVER add them
#     with a VITE_ or NEXT_PUBLIC_ prefix.
#   - GEMINI_API_KEY is set as a Supabase Edge Function secret, not here.
# =============================================================================

# ── Supabase (frontend — safe to expose) ─────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Backend URL (optional Java backend) ──────────────────────────────────────
VITE_BACKEND_URL=

# =============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# These are set via the Supabase CLI or Dashboard — NOT in this file.
# They are listed here for documentation only.
#
# To set them locally:
#   supabase secrets set GEMINI_API_KEY=AIza...
#   supabase secrets set GEMINI_MODEL=gemini-1.5-flash
#
# To set them in production (Supabase Dashboard):
#   Project → Edge Functions → Secrets
#
# GEMINI_API_KEY=           ← Set via supabase secrets set, never here
# GEMINI_MODEL=gemini-1.5-flash  ← Set via supabase secrets set, never here
#
# Supported Gemini models:
#   gemini-1.5-flash   (fast, cheap — recommended default)
#   gemini-1.5-pro     (higher quality, slower)
#   gemini-2.0-flash   (fastest, latest)
# =============================================================================
